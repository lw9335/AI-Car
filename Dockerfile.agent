FROM python:3.15-slim

ARG NEMOCLAW_TOOL_DISCLOSURE=progressive

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NEMOCLAW_TOOL_DISCLOSURE=${NEMOCLAW_TOOL_DISCLOSURE}

WORKDIR /app
RUN groupadd --system roadmind && useradd --system --gid roadmind --create-home roadmind
COPY --chown=roadmind:roadmind pyproject.toml README.md ./
COPY --chown=roadmind:roadmind src ./src
RUN pip install --no-cache-dir ".[agent]"

USER roadmind

EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8010/health')"

CMD ["uvicorn", "roadmind.assistant.main:app", "--host", "0.0.0.0", "--port", "8010"]
